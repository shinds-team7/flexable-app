# /opt/flexable/.env (아카데미 VM) — EC2 운영 .env를 복사한 뒤 아래 표시한 줄만 바꾼다. 이 파일은 커밋하지 않는다.
# JWT_SECRET·WEB_LINK_SERVICE_KEYS·카카오·Google 값은 EC2 값을 그대로 쓴다(JWT_SECRET을 바꾸면 전원 로그아웃).

# [바꿈] 같은 VM의 MySQL 컨테이너. TLS 없이 붙는다(RDS용 sslMode=REQUIRED 금지)
DB_URL=jdbc:mysql://db:3306/flexable?serverTimezone=UTC&characterEncoding=UTF-8&sslMode=DISABLED&allowPublicKeyRetrieval=true
DB_USERNAME=flexable_app
# [EC2 값 그대로] 새 MySQL 계정도 이 비밀번호로 만들어진다
DB_PASSWORD=
# [새로 추가] openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
MYSQL_ROOT_PASSWORD=
# [새로 추가] RDS와 같은 메이저 버전(SELECT VERSION(); 결과에 맞춤)
MYSQL_IMAGE=mysql:8.0

# [EC2 값 그대로] EC2 Caddy가 이 주소를 아카데미로 넘겨 주므로 앱·OAuth 주소는 바꾸지 않는다
JWT_SECRET=
CORS_ORIGINS=
OAUTH_CALLBACK_BASE_URL=https://flex-able-sh.duckdns.org
OAUTH_ALLOWED_REDIRECT_URIS=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_SCOPE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_LINK_SERVICE_KEYS=
