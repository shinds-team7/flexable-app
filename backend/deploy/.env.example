# /opt/flexable/.env (EC2) — 이 파일은 커밋하지 않는다. 권한 600.
# 새 서버: setup-db.sh가 빈 DB_PASSWORD·MYSQL_ROOT_PASSWORD·JWT_SECRET을 채운다.
# 아카데미에서 복귀할 때: 아카데미 VM의 .env를 그대로 가져와 WEB_DOMAIN만 더한다(docs/server-migration.md §8-2).

# Caddy가 인증서를 받는 두 도메인. 둘 다 EC2 탄력적 IP를 가리켜야 한다
API_DOMAIN=flex-able-sh.duckdns.org
# 웹(flexable-web) 주소. 같은 DuckDNS 계정의 두 번째 서브도메인을 제안(실제 값은 owner가 정함)
WEB_DOMAIN=

# 같은 EC2의 MySQL 컨테이너(db). TLS 없이 붙는다(RDS용 sslMode=REQUIRED 금지)
DB_URL=jdbc:mysql://db:3306/flexable?serverTimezone=UTC&characterEncoding=UTF-8&sslMode=DISABLED&allowPublicKeyRetrieval=true
DB_USERNAME=flexable_app
# DB_PASSWORD·MYSQL_ROOT_PASSWORD에 $를 넣지 않는다(compose가 값을 바꿔 버린다). setup-db.sh는 영숫자만 만든다
# MySQL 볼륨이 처음 만들어질 때만 이 값으로 계정이 생긴다. 그 뒤에 바꾸면 접속이 끊긴다
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_IMAGE=mysql:8.4

# 바꾸면 전원 로그아웃
JWT_SECRET=
CORS_ORIGINS=https://project2-flex-sh.vercel.app,http://localhost:8081

# 소셜 로그인: 각 공급자 콘솔에서 callback URL을 등록한 뒤 서버에서 채운다.
OAUTH_CALLBACK_BASE_URL=https://flex-able-sh.duckdns.org
OAUTH_ALLOWED_REDIRECT_URIS=flexable://oauth/callback,https://project2-flex-sh.vercel.app/oauth/callback,http://localhost:8081/oauth/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_SCOPE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI 메이트(POST /chat/messages). 비우면 503. 개인정보처리방침 반영 전에는 운영에 넣지 않는다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 웹사이트 연동: 웹 서버(flexable-web)와 같은 값. 32자 이상 임의 문자열, 쉼표로 두 개까지(교체 중)
WEB_LINK_SERVICE_KEYS=
