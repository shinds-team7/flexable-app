# /opt/flexable/.env — setup-db.sh가 DB·JWT 값을 채운다. 이 파일은 커밋하지 않는다.
API_DOMAIN=flex-able-sh.duckdns.org
DB_URL=jdbc:mysql://database-flex.cdi4cs8mempl.ap-northeast-2.rds.amazonaws.com:3306/flexable?serverTimezone=UTC&characterEncoding=UTF-8&sslMode=REQUIRED
DB_USERNAME=flexable_app
DB_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://project2-flex-sh.vercel.app,http://localhost:8081

# 소셜 로그인: 각 공급자 콘솔에서 callback URL을 등록한 뒤 서버에서 채운다.
OAUTH_CALLBACK_BASE_URL=https://flex-able-sh.duckdns.org
OAUTH_ALLOWED_REDIRECT_URIS=flexable://oauth/callback,https://project2-flex-sh.vercel.app/oauth/callback,http://localhost:8081/oauth/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_SCOPE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
