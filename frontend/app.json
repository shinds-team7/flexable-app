{
  "expo": {
    "name": "텅장관리",
    "slug": "flexable",
    "version": "1.6.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.flexable.app",
      "adaptiveIcon": {
        "backgroundColor": "#0046FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Flex-able 텅장관리",
      "themeColor": "#0046FF"
    },
    "scheme": "flexable",
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-navigation-bar", { "hidden": true }],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "거래내역 스크린샷을 고르려고 사진에 접근해요. 고른 사진은 기기에서만 읽어요",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "./plugins/withSplashBranding",
        {
          "image": "./assets/splash-branding.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0046FF"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0046FF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb9b50f5-3e92-4eb3-8cea-1c1a149b23ef"
      }
    },
    "owner": "ucmnuniverse-developer",
    "updates": {
      "url": "https://u.expo.dev/fb9b50f5-3e92-4eb3-8cea-1c1a149b23ef"
    }
  }
}
