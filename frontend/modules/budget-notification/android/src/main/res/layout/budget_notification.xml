<?xml version="1.0" encoding="utf-8"?>
<!-- 모든 구성이 아이콘 높이(48dp) 안에 들어간다: 왼쪽 고양이, 가운데 2행(라벨·금액), 오른쪽 기록·홈 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="48dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <ImageView
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:contentDescription="@null"
    android:scaleType="fitCenter"
    android:src="@drawable/budget_cat" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="오늘 남은 예산"
      android:textColor="#A0A4A8"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/budget_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="#0046FF"
      android:textSize="20sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/budget_record"
    android:layout_width="44dp"
    android:layout_height="match_parent"
    android:clickable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:contentDescription="@null"
      android:src="@drawable/ic_budget_record" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="기록"
      android:textColor="#A0A4A8"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/budget_home"
    android:layout_width="44dp"
    android:layout_height="match_parent"
    android:clickable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:contentDescription="@null"
      android:src="@drawable/ic_budget_home" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="홈"
      android:textColor="#A0A4A8"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
