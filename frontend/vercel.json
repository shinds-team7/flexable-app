{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://flexable-web-delta.vercel.app/m",
      "permanent": false
    },
    {
      "source": "/demo/:path*",
      "destination": "https://flexable-web-delta.vercel.app/m/:path*",
      "permanent": false
    },
    {
      "source": "/home2",
      "destination": "https://flexable-web-delta.vercel.app/m/home2",
      "permanent": false
    },
    {
      "source": "/plan",
      "destination": "https://flexable-web-delta.vercel.app/m/plan",
      "permanent": false
    },
    {
      "source": "/budget-detail",
      "destination": "https://flexable-web-delta.vercel.app/m/budget-detail",
      "permanent": false
    },
    {
      "source": "/notifications",
      "destination": "https://flexable-web-delta.vercel.app/m/notifications",
      "permanent": false
    },
    {
      "source": "/memory",
      "destination": "https://flexable-web-delta.vercel.app/m/memory",
      "permanent": false
    },
    {
      "source": "/schedule",
      "destination": "https://flexable-web-delta.vercel.app/m/schedule",
      "permanent": false
    },
    {
      "source": "/schedule/:path*",
      "destination": "https://flexable-web-delta.vercel.app/m/schedule/:path*",
      "permanent": false
    },
    {
      "source": "/tx/:id",
      "destination": "https://flexable-web-delta.vercel.app/m/tx/:id",
      "permanent": false
    },
    {
      "source": "/settle/:id",
      "destination": "https://flexable-web-delta.vercel.app/m/settle/:id",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
