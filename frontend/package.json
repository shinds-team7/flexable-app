{
  "name": "flexable-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-ml-kit/text-recognition": "2.0.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:unit": "node --test \"test/*.test.cjs\"",
    "gen:api": "npx --yes openapi-typescript@7.13.0 ../docs/contracts/app-api.yaml -o src/service/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/service/api/schema.d.ts",
    "mock:api": "node scripts/mock-api.cjs",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview --platform android",
    "update:promote": "npx eas-cli@latest update:republish --destination-channel production --platform android --non-interactive --group"
  },
  "private": true
}
